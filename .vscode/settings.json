{
  "dart.lineLength": 90,
  "dart.previewFlutterUiGuides": true,
  "editor.formatOnSave": true,
  "editor.rulers": [90],
  "[dart]": {
    "editor.defaultFormatter": "Dart-Code.dart-code",
    "editor.codeActionsOnSave": { "source.fixAll": "explicit" }
  },
  "files.exclude": {
    "**/.dart_tool": true,
    "**/build": true
  }
}
